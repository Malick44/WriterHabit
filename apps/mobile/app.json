{
  "name": "WriteWise",
  "slug": "writewise",
  "version": "0.1.0",
  "platforms": [
    "ios",
    "android"
  ],
  "orientation": "default",
  "icon": "./assets/images/logo.png",
  "scheme": "writewise",
  "userInterfaceStyle": "light",
  "runtimeVersion": {
    "policy": "fingerprint"
  },
  "updates": {
    "url": "https://u.expo.dev/WRITEWISE_EAS_PROJECT_ID_REQUIRED",
    "enabled": true,
    "checkAutomatically": "ON_LOAD",
    "fallbackToCacheTimeout": 0
  },
  "plugins": [
    "expo-font",
    "expo-sqlite",
    [
      "expo-notifications",
      {
        "color": "#00327D",
        "defaultChannel": "writewise-reminders"
      }
    ],
    "expo-router"
  ],
  "ios": {
    "bundleIdentifier": "com.writewise",
    "buildNumber": "1",
    "supportsTablet": true,
    "icon": "./assets/images/logo.png",
    "associatedDomains": [
      "applinks:writewise.app"
    ]
  },
  "android": {
    "package": "com.writewise",
    "versionCode": 1,
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/logo.png",
      "backgroundColor": "#FFFFFF"
    },
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "https",
            "host": "writewise.app",
            "pathPrefix": "/"
          }
        ],
        "category": [
          "BROWSABLE",
        "DEFAULT"
        ]
      }
    ]
  },
  "extra": {
    "eas": {
      "projectId": "WRITEWISE_EAS_PROJECT_ID_REQUIRED"
    }
  }
}
