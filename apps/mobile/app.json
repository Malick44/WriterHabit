{
  "icon": "./assets/images/logo.png",
  "scheme": "writewise",
  "plugins": [
    "expo-font",
    "expo-sqlite",
    [
      "expo-notifications",
      {
        "color": "#00327D",
        "defaultChannel": "writewise-reminders"
      }
    ]
  ],
  "ios": {
    "bundleIdentifier": "com.writewise",
    "icon": "./assets/images/logo.png"
  },
  "android": {
    "package": "com.writewise",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/logo.png",
      "backgroundColor": "#FFFFFF"
    }
  }
}
